# Loaded by Vitest (mode=test). Committed on purpose.
#
# Vite STATICALLY REPLACES import.meta.env.VITE_* with a literal at transform
# time - it is a compile-time substitution, not a runtime lookup. So
# vi.stubEnv() cannot affect it, and the only way for a test to exercise the
# real authHeaders() path is for the value to be present when the test bundle is
# built. That is what this file is for.
#
# The key is obviously fake and reaches no real gateway. .gitignore allows this
# file explicitly alongside .env.example.
VITE_API_KEY=sk-test-key
