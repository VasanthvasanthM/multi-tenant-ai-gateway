# Copy to .env.local. .env* is gitignored except this example.

# Where the gateway is. In development Vite proxies /v1 here, so the browser
# never makes a cross-origin request and the gateway needs no CORS policy.
VITE_GATEWAY_URL=http://localhost:8080

# The tenant API key.
#
# THIS IS A DEVELOPMENT CONVENIENCE ONLY. Anything in a VITE_ variable is
# compiled into the bundle and therefore public - it is visible in the browser
# devtools of every user. A real deployment must not ship a tenant credential
# this way; see the note at the top of src/api/client.ts for what it should do
# instead.
VITE_API_KEY=sk-dev-local
