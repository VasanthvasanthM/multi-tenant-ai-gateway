<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="ai-gateway"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <!--
      A WARNING BEFORE YOU ADD AN EXCLUSION.

      An <exclude> only applies inside the <rule ref="category/..."> block that actually
      defines that rule. Putting it in the wrong category is NOT an error - PMD accepts
      it silently and the rule keeps firing. That cost three build cycles here:
      AvoidFieldNameMatchingMethodName (errorprone, not codestyle), UseUtilityClass
      (design, not bestpractices) and AvoidCatchingGenericException (design, not
      errorprone) were all excluded in the wrong place first.

      Check the rule's category at https://docs.pmd-code.org/latest/pmd_rules_java.html
      before adding one, or confirm the violation count actually drops.
    -->
    <description>
        Curated PMD ruleset for a reactive Spring WebFlux service.

        The stock "bestpractices" and "design" categories are imported wholesale
        and then narrowed, because several default rules actively fight reactive
        code (long fluent chains are idiomatic Reactor, not a code smell) and a
        wall of false positives trains people to ignore the report entirely.
    </description>

    <rule ref="category/java/bestpractices.xml">
        <!-- Reactor chains legitimately exceed the default method length. -->
        <exclude name="GuardLogStatement"/>
        <!-- JUnit 5 assertions are detected as "no assert" by the JUnit4 rule. -->
        <exclude name="JUnitTestsShouldIncludeAssert"/>
        <!-- Fires on Embedding(float[] values). A 384-component vector is a single
             value, not a variable argument list; varargs would invite callers to write
             `new Embedding(0.1f, 0.2f)` for something that must always be 384 long. -->
        <exclude name="UseVarargs"/>
        <!-- Our single-method interfaces (ApiKeyRegistry, LlmProvider) are service SPIs
             expected to grow, not lambda targets. -->
        <exclude name="ImplicitFunctionalInterface"/>
        <!-- Fires on Spring's HttpHeaders, which has no interface to depend on. -->
        <exclude name="LooseCoupling"/>
    </rule>

    <rule ref="category/java/errorprone.xml">
        <!-- FALSE POSITIVE ON RECORDS. Fires on TenantId, ModelId and ShardId, which
             implement Comparable. They are records, so the compiler generates equals()
             and hashCode() - the rule predates records and cannot see them. -->
        <exclude name="OverrideBothEqualsAndHashCodeOnComparable"/>
        <!-- Fires on repeated @JsonProperty values such as "tid". Extracting a constant
             for a JSON field name makes the mapping harder to read, not easier. -->
        <exclude name="AvoidDuplicateLiterals"/>
        <!-- The accessor convention: a field `label` with a method `label()`. Every value
             type here is written that way, and records generate exactly this shape.
             NOTE: this rule lives in errorprone, not codestyle - excluding it from the
             wrong category is silently a no-op, which cost one build to discover. -->
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <!-- Records and sealed interfaces trip the legacy null-assignment rule. -->
        <exclude name="NullAssignment"/>
        <exclude name="AvoidLiteralsInIfCondition"/>
        <!-- Spring @Value / @ConfigurationProperties beans need no explicit ctor. -->
        <exclude name="MissingSerialVersionUID"/>

        <!--
          FALSE POSITIVE, AND A DANGEROUS ONE TO "FIX".

          Fires on the Predictor borrowed from the pool in OnnxEmbeddingModel. PMD sees a
          closeable obtained and never closed, and it is right about the shape - but the
          predictor is POOLED. The finally block returns it with pool.add(); closing it
          would destroy a pooled instance, and after `concurrency` calls the pool would be
          empty and every request would fail on borrow timeout.

          The pool's real lifecycle is OnnxEmbeddingModel.close(), which drains and closes
          each predictor exactly once.
        -->
        <exclude name="CloseResource"/>

        <!-- `while ((p = pool.poll()) != null)` is the idiomatic drain loop. Used once,
             in close(). -->
        <exclude name="AssignmentInOperand"/>

    </rule>

    <rule ref="category/java/multithreading.xml">
        <!--
          `volatile` is correct here, not a smell.

          The rule exists because volatile is often misused as a cheap substitute for real
          synchronisation. EventConsumerRunner.subscription is the textbook valid case: a
          single reference written by start() on the Spring lifecycle thread and read by
          stop() and isRunning() from other threads. Without volatile there is no
          happens-before edge, and stop() can legally observe a stale null - leaving a
          consumer running after shutdown, which is exactly the bug this rule would cause
          if followed.
        -->
        <exclude name="AvoidUsingVolatile"/>
        <!-- WebFlux forbids blocking; we enforce that with BlockHound at runtime
             and ArchUnit at build time, which is far more precise than PMD. -->
        <exclude name="DoNotUseThreads"/>
        <exclude name="UseConcurrentHashMap"/>
    </rule>

    <rule ref="category/java/performance.xml"/>

    <!--
      Logger fields are named `log`, not `LOG`.

      PMD's default constant pattern demands SCREAMING_CASE for every static final field.
      `log` is the near-universal SLF4J convention - it is what Lombok's @Slf4j generates
      and what every Spring codebase uses - so the rule is reconfigured rather than
      disabled, keeping the check for genuinely badly named constants.
    -->
    <rule ref="category/java/codestyle.xml/FieldNamingConventions">
        <properties>
            <property name="constantPattern" value="log|[A-Z][A-Z_0-9]*"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml">
        <exclude name="LawOfDemeter"/>          <!-- unusable with fluent builders -->
        <exclude name="LoosePackageCoupling"/>
        <exclude name="ExcessiveImports"/>      <!-- Spring config classes -->
        <exclude name="TooManyMethods"/>
        <!-- GatewayEvents is deliberately a holder of records and topic constants.
             "This is a data class" is the intent, not a finding. -->
        <exclude name="DataClass"/>
        <!-- Fires on every @SpringBootApplication class, which holds only main(). The
             rule's suggested fix - a private constructor - is wrong here, because Spring
             instantiates the class as a configuration bean.
             NOTE: this rule is in design, not bestpractices. -->
        <exclude name="UseUtilityClass"/>
        <!--
          Deliberate in exactly one place: GatewayEventPublisher.emit.

          That method is fire-and-forget telemetry on the request path, and its contract
          is that NOTHING it does can fail a request. Narrowing the catch would let an
          unanticipated runtime exception escape into the response path, which is the
          failure this design exists to prevent. Elsewhere the catches are narrow - the
          Ollama and OpenAI chunk parsers were tightened to JsonProcessingException
          after this rule flagged them.
        -->
        <exclude name="AvoidCatchingGenericException"/>
    </rule>

    <!-- Complexity thresholds: deliberately stricter than PMD defaults. A
         gateway handler that needs a CYCLO above 10 is hiding a missing
         abstraction, and that is exactly what we want the build to catch. -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="classReportLevel" value="60"/>
            <property name="methodReportLevel" value="10"/>
        </properties>
    </rule>

    <!--
      Coupling threshold raised from 20 to 30.

      Fires on CompletionPipeline (23) and Tier2SemanticCache (21). Both are
      orchestrators: the pipeline exists precisely to coordinate two cache tiers, an
      embedding service, a provider registry and a rate limiter, so it references many
      types by design. Splitting it to satisfy the metric would scatter one readable
      sequence across several classes and make the request path harder to follow, which
      is the opposite of the rule's intent.

      Raised rather than disabled, so a class that genuinely sprawls past 30 is still
      reported.
    -->
    <rule ref="category/java/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="threshold" value="30"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/NPathComplexity">
        <properties>
            <property name="reportLevel" value="200"/>
        </properties>
    </rule>

    <!--
      Codestyle is the category that decides whether this report gets read.

      A first run produced 106 violations, of which 8 were real. The other 98 came from
      rules that are style preferences or that predate modern Java, and a report where
      92% of entries are noise trains people to ignore all of it - including the 8 that
      mattered. Each exclusion below names why that rule does not fit THIS codebase.
    -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="OnlyOneReturn"/>
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="LongVariable"/>
        <exclude name="ShortClassName"/>
        <exclude name="CommentDefaultAccessModifier"/>

        <!-- 67 of the 106 violations. A preference, not a defect class: nothing here
             reassigns a parameter, and adding `final` to every argument and local would
             be a large diff that prevents no bug. -->
        <exclude name="MethodArgumentCouldBeFinal"/>
        <exclude name="LocalVariableCouldBeFinal"/>

        <!-- Fires on `of`, `id`, `db`, `m`. Short names are correct where the scope is
             two lines or the name is an established factory idiom. -->
        <exclude name="ShortMethodName"/>
        <exclude name="ShortVariable"/>

        <!-- Flags `isHealthy()` returning Mono<Boolean>. Inherent to a reactive API -
             the alternative would be naming every reactive predicate awkwardly. -->
        <exclude name="LinguisticNaming"/>
    </rule>

</ruleset>
